educ_viz_data <- bind_rows(
# Unweighted data
unweighted_by_education |>
filter(Q21 == 1) |>  # Only "Yes" responses (Q21=1)
mutate(Type = "Unweighted") |>
select(Type, educ, percentage),
# Weighted data -
weighted_by_education |>
filter(Q21 == 1) |>  # Only "Yes" responses
mutate(
Type = "Weighted",
percentage = Yes
) |>
select(Type, educ, percentage)
